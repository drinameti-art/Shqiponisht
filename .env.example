# Copy to .env and fill in. These are RevenueCat's *public* SDK keys — safe to ship in the app.
# RevenueCat dashboard → your project → API keys.
# Add these once the App Store / Google Play apps exist in RevenueCat (see STORE_SETUP.md):
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# RevenueCat Test Store (project "Shqiponisht"): simulated purchases for development builds.
# Used only when the store keys above are not set. Never ship it in a store build.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_tTaexqrCvukLUtaqZtKhiBFthUD

# Accounts backend: the Shqiponisht Supabase project (EU, Frankfurt). See supabase/README.md.
# These are public by design (the publishable key ships in the app; row-level security protects the data).
# Never put a secret / service_role key in this file.
EXPO_PUBLIC_SUPABASE_URL=https://voubpqzndizofrlyezea.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_97l9GbLJVF053nX-1LVNTA_zQGALGiL

# Only for web previews: shows a "Provo Plus (demo)" button. NEVER set this for store builds.
# EXPO_PUBLIC_DEMO_PLUS=1
